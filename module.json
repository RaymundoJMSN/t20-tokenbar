{
  "id": "t20-tokenbar",
  "title": "T20 TokenBar",
  "description": "Mod do Monk's TokenBar para Tormenta20: sobe de nível de verdade, mostra a inspiração do t20-inspiracao, e dá aos jogadores uma lista de stats própria com o texto do Health Estimate no lugar do PV exato.",
  "version": "1.0.0",
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "relationships": {
    "requires": [
      {
        "id": "monks-tokenbar",
        "type": "module"
      }
    ],
    "systems": [
      {
        "id": "tormenta20",
        "type": "system"
      }
    ]
  },
  "esmodules": [
    "scripts/main.mjs"
  ],
  "styles": [
    "styles/t20-tokenbar.css"
  ],
  "flags": {
    "hotReload": {
      "extensions": [
        "css"
      ],
      "paths": [
        "styles/t20-tokenbar.css"
      ]
    }
  },
  "authors": [
    {
      "name": "RaymundoNeto",
      "url": "https://github.com/RaymundoJMSN"
    }
  ],
  "url": "https://github.com/RaymundoJMSN/t20-tokenbar",
  "manifest": "https://github.com/RaymundoJMSN/t20-tokenbar/releases/latest/download/module.json",
  "download": "https://github.com/RaymundoJMSN/t20-tokenbar/releases/latest/download/module.zip"
}
